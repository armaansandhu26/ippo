.env
__pycache__/
*.pyc
# Large generated artifacts only (keep docs like data/PIPELINE.md trackable).
# Do not use a bare `data/` rule: it ignores src/data/*.py and data/*.md.
/data/raw/
/data/mcq_raw/
# Processed: ignore bulk intermediates; track final / reproducible judge artifacts for teammates.
/data/processed/*
!/data/processed/prelim_train.jsonl
!/data/processed/prelim_test.jsonl
!/data/processed/mcq_judge_passed.jsonl
!/data/processed/mcq_judged.jsonl
!data/processed/unbiased_prelim_train_with_original_reasoning.jsonl
experiments/*/logs/
venv/
notebooks/
!src/notebooks/

### added for process-scripts in the repo.
ps/
process-scripts/
logs/
unsloth_compiled_cache/
report/

# macOS metadata
.DS_Store

# benchmark + run artifacts (generated/bulky)
*.zip

# Raw per-step row dumps (regenerable from run trees)
**/benchmark_rows*.jsonl
**/recovery_rows*.jsonl
**/recovery_history.jsonl

# Wide row tables outside benchmark_metrics (CSVs under benchmark_metrics/ are tracked)
results/**/benchmark_rows.csv

# Local training/eval run trees (summaries live under benchmark_metrics/)
/qwen2.5_family_runs/
/qwen_2.5_family_and_llama_3.x_family_runs_v1/
/qwen_2.5_family_runs_v1_only/
/llama_3.x_family_runs_v1_only/
/qwen_2.5_family_and_llama_3.x_family_recovery_runs_v1/
qwen_14b_missing_runs_with_recovery/
qwen_14b_missing_logs_with_recovery/
llama_missing_recovery_log/
condition_recovery_*/

# Slurm / run logs
*_family_logs*/
*_recovery_logs*/
*_missing_*log*/
**/run.log
benchmark_metrics/judge/*.log

# LaTeX paper draft (paper_writing.tex) — ignore build outputs
paper_writing.log
paper_writing.tex